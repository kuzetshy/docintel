# Copy to .env and fill in real values. Never commit .env.

# LLM providers (set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# Generate random values with: openssl rand -hex 32
# (hex only: passwords end up inside connection URLs, special chars break them)

# PostgreSQL (required by docker compose)
POSTGRES_HOST=localhost
# Host port; change it (e.g. 5433) if a local Postgres already listens on 5432.
POSTGRES_PORT=5432
POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=

# Qdrant
QDRANT_URL=http://localhost:6333

# Langfuse client (used by the app)
# Any values with these prefixes; Langfuse creates the project with them on first start.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-

# Langfuse server (only for: docker compose --profile observability)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@docintel.local
LANGFUSE_INIT_USER_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=
